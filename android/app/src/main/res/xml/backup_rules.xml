<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup is disabled at the application level (allowBackup=false). These
     rules exist for completeness and to document intent: even if backup were
     enabled, the encrypted key prefs and the multi-hundred-MB sandbox must
     never be backed up. The Keystore master key is hardware-bound and does not
     survive a restore, so backing up its ciphertext is useless and risky. -->
<full-backup-content>
    <exclude domain="sharedpref" path="pifilling_secure_prefs.xml" />
    <exclude domain="file" path="linux-sandbox/" />
</full-backup-content>
